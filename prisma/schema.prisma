generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Note {
  id       Int       @id @default(autoincrement())
  title    String
  content  String?
  concepts Concept[]
}

model Concept {
  id    Int    @id @default(autoincrement())
  name  String @unique
  notes Note[]
}